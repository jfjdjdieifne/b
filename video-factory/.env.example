# Never commit real values. Use one credential pair per Kaggle account.
# Recommended multi-account setup (add more numbered pairs as needed):
KAGGLE_USERNAME_1=
KAGGLE_API_TOKEN_1=
KAGGLE_USERNAME_2=
KAGGLE_API_TOKEN_2=
KAGGLE_USERNAME_3=
KAGGLE_API_TOKEN_3=

# Optional account labels/slugs (not secrets). Defaults: account-1, account-2, ...
# KAGGLE_ACCOUNT_ID_1=primary
# KAGGLE_KERNEL_SLUG_1=wan-video-worker

# Alternative: one JSON secret. Numbered slots above take precedence when populated.
# KAGGLE_ACCOUNTS_JSON='[{"id":"primary","username":"USER_1","api_token":"TOKEN_1"},{"id":"backup","username":"USER_2","api_token":"TOKEN_2"}]'

# Backward-compatible single-account mode, used only when no numbered/JSON pool exists:
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KERNEL_SLUG=wan-video-worker

# Hugging Face ZeroGPU caller token (current live-tested route).
# Optional for a tiny anonymous quota; a free account gets 5 renewable GPU min/day.
# Create a fine-grained read token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Free.ai adapter is retained only as rejected/disabled experimental code.
# Never commit or print the real value.
FREE_AI_API_KEY=
# Leave empty to use Free.ai's self-hosted default; premium/* ids consume paid tokens.
FREE_AI_VIDEO_MODEL=

# Optional secondary user-pays video route (Puter Node/browser automation):
PUTER_AUTH_TOKEN=
# Optional YouTube OAuth; only needed when publishing is enabled:
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
