# انسخ الملف إلى .env ثم عدّل القيم التي تحتاجها فقط:
# cp .env.example .env

# اختيار منصة البيانات الافتراضية: auto / okx / binance / kucoin / gate / bybit / mexc
DEFAULT_EXCHANGE=auto
DEFAULT_SYMBOL=BTC/USDT

# سياسات تنفيذ اختيارية فقط؛ 0 = معطلة. لا تغيّر أسعار TP/SL الهيكلية.
MIN_RR_POLICY=0
MAX_SL_POLICY_PCT=0

# اختياري: واجهة Telegram (لا تضع مفاتيح تداول المنصة هنا)
TELEGRAM_BOT_TOKEN=

# اختياري: مسار التحليل اللغوي القديم متعدد المراحل
OPENROUTER_API_KEY=
# أو عدة مفاتيح مفصولة بفواصل
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_TIMEOUT_SECONDS=150
OPENROUTER_REASONING_EFFORT=none
MAX_TOKENS=24576
TEMPERATURE=0.1
